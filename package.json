{
  "name": "jarvis-reader",
  "version": "1.0.2",
  "private": true,
  "description": "TypeScript source migration workspace for Jarvis Reader",
  "type": "module",
  "overrides": {
    "@xmldom/xmldom": "0.8.13"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "verify": "npm run typecheck && npm test && npm run build && node --check main.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "esbuild": "^0.25.0",
    "obsidian": "^1.8.0",
    "react": "18.2.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "react-dom": "18.2.0",
    "react-reader": "0.20.4"
  }
}

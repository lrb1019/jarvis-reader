{
  "name": "jarvis-reader",
  "version": "1.4.6",
  "description": "Read EPUBs, capture highlights and reflections in Markdown, and connect reading notes to knowledge notes.",
  "private": true,
  "type": "module",
  "overrides": {
    "@xmldom/xmldom": "0.8.15"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc --noEmit -p tsconfig.strict.json",
    "test": "node --test tests/*.test.ts",
    "build": "npm run licenses:check && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "verify": "npm run typecheck && npm run typecheck:strict && npm test && npm run build && node --check main.js",
    "deploy:local": "npm run verify && node deploy-local.mjs",
    "package:release": "node release-package.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "package:dictionary": "node package-dictionary.mjs",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "licenses:check": "node scripts/generate-third-party-notices.mjs --check",
    "submission:check": "npm run licenses:check && node scripts/check-submission.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "esbuild": "^0.25.0",
    "obsidian": "^1.8.0",
    "react": "18.2.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "epubjs": "0.3.93",
    "react-dom": "18.2.0",
    "react-reader": "0.20.4",
    "jszip": "3.10.1"
  },
  "license": "MIT",
  "author": "Bylrb",
  "repository": {
    "type": "git",
    "url": "https://github.com/lrb1019/jarvis-reader.git"
  },
  "homepage": "https://github.com/lrb1019/jarvis-reader#readme",
  "bugs": {
    "url": "https://github.com/lrb1019/jarvis-reader/issues"
  }
}
